---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import Datetime from "./Datetime.astro";
import { SITE } from "@/config";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"blog">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, ogImage: initOgImage, ...props } = data;

const postPath = getPath(id, filePath);

// Thumbnail: a local ogImage goes through Astro's optimizer (resized with a proper filter,
// served as WebP at the displayed size). A string ogImage or the dynamic OG image falls back to <img>.
const thumbAsset = initOgImage && typeof initOgImage === "object" ? initOgImage : undefined;
let thumbUrl: string | undefined;
if (typeof initOgImage === "string") {
  thumbUrl = initOgImage;
} else if (!thumbAsset && SITE.dynamicOgImage) {
  thumbUrl = `${postPath}/index.png`;
}
const thumbClass = "w-full h-40 sm:w-48 sm:h-28 object-cover rounded border border-border flex-shrink-0";
---

<li class="my-6">
  <a
    href={postPath}
    class="group flex flex-col gap-3 sm:flex-row sm:gap-4 sm:items-start"
  >
    {thumbAsset ? (
      <Image
        src={thumbAsset}
        alt=""
        widths={[384, 768, 1200]}
        sizes="(min-width: 640px) 192px, 100vw"
        quality={85}
        class={thumbClass}
        loading="lazy"
      />
    ) : thumbUrl && (
      <img src={thumbUrl} alt="" class={thumbClass} loading="lazy" />
    )}
    <div class="flex-1 min-w-0">
      <Heading
        class:list={[
          "inline-block text-lg font-semibold tracking-tight",
          "decoration-dashed underline-offset-4 group-hover:text-accent group-hover:underline",
        ]}
        style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
      >
        {title}
      </Heading>
      <Datetime {...props} />
      <p class="mt-1">{description}</p>
    </div>
  </a>
</li>
