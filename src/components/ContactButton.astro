---
// "Get in touch" opens a small panel instead of a mailto: link. mailto depends on
// the visitor's OS mail handler (often unset, or set to a browser), so the panel
// offers ways that always work: copy the address, compose in Gmail, or LinkedIn.
import IconMail from "@/assets/icons/IconMail.svg";
import IconLinkedin from "@/assets/icons/IconLinkedin.svg";

type Props = { class?: string; label?: string };

const { class: className = "", label = "Get in touch" } = Astro.props;
const EMAIL = "evgeni.n.rusev@gmail.com";
const LINKEDIN = "https://www.linkedin.com/in/evgeni-rusev-24636017b/";
const GMAIL = `https://mail.google.com/mail/?view=cm&fs=1&to=${EMAIL}`;
const item =
  "flex w-full items-center gap-3 rounded-md px-3 py-2.5 text-left text-sm font-medium hover:bg-muted focus-visible:bg-muted";
---

<details data-contact class="relative inline-block">
  <summary
    class:list={[
      "inline-flex cursor-pointer list-none items-center rounded-lg bg-accent px-5 py-2.5 font-semibold text-background select-none hover:opacity-90 focus-visible:outline-offset-2 [&::-webkit-details-marker]:hidden",
      className,
    ]}
  >
    {label}
  </summary>
  <div
    class="absolute top-full left-0 z-20 mt-2 w-72 rounded-xl border border-border bg-background p-2 shadow-lg"
    role="menu"
  >
    <p class="px-3 pt-1.5 pb-2 font-mono text-xs opacity-70">{EMAIL}</p>
    <button type="button" data-copy={EMAIL} class={item} role="menuitem">
      <svg aria-hidden="true" class="size-5 shrink-0 opacity-80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg><span data-copy-label>Copy email address</span>
    </button>
    <a href={GMAIL} target="_blank" rel="noopener" class={item} role="menuitem">
      <IconMail aria-hidden="true" class="size-5 shrink-0 opacity-80" />Write in Gmail
    </a>
    <a href={LINKEDIN} target="_blank" rel="noopener" class={item} role="menuitem">
      <IconLinkedin aria-hidden="true" class="size-5 shrink-0 opacity-80" />Message on LinkedIn
    </a>
  </div>
</details>

<script>
  function wireContact() {
    document.querySelectorAll<HTMLDetailsElement>("details[data-contact]").forEach(d => {
      if (d.dataset.wired) return;
      d.dataset.wired = "1";
      const copy = d.querySelector<HTMLButtonElement>("[data-copy]");
      const label = d.querySelector<HTMLElement>("[data-copy-label]");
      copy?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(copy.dataset.copy!);
          if (label) label.textContent = "Copied!";
        } catch {
          if (label) label.textContent = copy.dataset.copy!;
        }
        setTimeout(() => label && (label.textContent = "Copy email address"), 2000);
      });
    });
  }
  // Close any open panel on outside click or Escape.
  document.addEventListener("click", e => {
    document.querySelectorAll<HTMLDetailsElement>("details[data-contact][open]").forEach(d => {
      if (!d.contains(e.target as Node)) d.open = false;
    });
  });
  document.addEventListener("keydown", e => {
    if (e.key === "Escape")
      document.querySelectorAll<HTMLDetailsElement>("details[data-contact][open]").forEach(d => (d.open = false));
  });
  document.addEventListener("astro:page-load", wireContact);
</script>
