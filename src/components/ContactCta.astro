---
// End-of-article prompt for readers who are evaluating whether to get in touch.
import ContactButton from "./ContactButton.astro";
---

<aside data-pagefind-ignore class="my-10 max-w-[42rem] rounded-xl border border-border px-6 py-6">
  <p class="text-lg font-bold tracking-tight">Facing something similar?</p>
  <p class="mt-1 opacity-90">
    I help teams take AI from pilot to production. Happy to compare notes on your case.
  </p>
  <div class="mt-4 flex flex-wrap items-center gap-3">
    <ContactButton />
  </div>
</aside>
