---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import ProfileAvatar from "@/components/ProfileAvatar.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { FEATURED_CASE_STUDIES } from "@/data/featuredCaseStudies";

const CONTACT_HREF = "mailto:evgeni.n.rusev@gmail.com";

const posts = await getCollection("blog");
// One list, newest first: featured posts no longer get a separate section.
const latestPosts = getSortedPosts(posts).slice(0, SITE.postPerIndex + 2);

const sectionHeading = "font-mono text-sm tracking-widest uppercase opacity-70";
const moreLink =
  "inline-flex items-center gap-1 font-mono text-sm underline decoration-dashed underline-offset-4 hover:text-accent";
const primaryButton =
  "inline-flex items-center rounded-lg bg-accent px-5 py-2.5 font-semibold text-background hover:opacity-90 focus-visible:outline-offset-2";
const secondaryButton =
  "inline-flex items-center gap-1 rounded-lg border border-border px-5 py-2.5 font-semibold hover:border-accent hover:text-accent";
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero" class="border-b border-border pt-10 pb-12 sm:pt-14">
      <div class="flex flex-col-reverse items-center gap-8 sm:flex-row sm:items-start">
        <div class="w-full sm:flex-1">
          <p class="font-mono text-sm tracking-wide opacity-70">
            Evgeni Rusev · Solution Architect at
            <a href="https://tecknoworks.com" class="underline decoration-dashed underline-offset-4 hover:text-accent">Tecknoworks</a>
          </p>
          <h1 class="mt-3 text-3xl leading-snug font-medium tracking-tight sm:text-[2.6rem]">
            I design applied AI and software solutions that make it to production.
          </h1>
          <p class="mt-5 max-w-[38rem] text-lg leading-relaxed opacity-90">
            Forward-deployed with clients across legal tech, manufacturing, mining and insurance, from
            solution design and technology selection through delivery, with a focus on integration,
            security and production readiness. Here I write about AI-native engineering and what
            actually works in the field.
          </p>
          <div class="mt-7 flex flex-wrap items-center gap-3">
            <a href={CONTACT_HREF} class={primaryButton}>Get in touch</a>
            <a href="/case-studies/" class={secondaryButton}>
              See case studies <IconArrowRight class="inline-block size-5 rtl:-rotate-180" />
            </a>
          </div>
          <div class="mt-6"><Socials /></div>
        </div>
        <ProfileAvatar />
      </div>
    </section>

    <section id="case-studies" class="border-b border-border pt-12 pb-12">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class={sectionHeading}>Selected work</h2>
        <a href="/case-studies/" class={moreLink}>
          All case studies <IconArrowRight class="inline-block size-4 rtl:-rotate-180" />
        </a>
      </div>
      <ul class="mt-6 grid gap-6 sm:grid-cols-3">
        {
          FEATURED_CASE_STUDIES.map(cs => (
            <li>
              <a
                href={`/case-studies/${cs.slug}/`}
                class="group flex h-full flex-col overflow-hidden rounded-xl border border-border transition-colors hover:border-accent"
              >
                <img
                  src={`/images/case-studies/${cs.slug}.webp`}
                  alt=""
                  width="960"
                  height="540"
                  loading="lazy"
                  class="aspect-video w-full border-b border-border object-cover"
                />
                <div class="flex flex-1 flex-col p-5">
                  <p class="text-3xl font-extrabold tracking-tight text-accent">{cs.metric}</p>
                  <p class="mt-1 text-sm opacity-80">{cs.metricLabel}</p>
                  <h3 class="mt-4 font-semibold leading-snug tracking-tight decoration-dashed underline-offset-4 group-hover:underline">
                    {cs.title}
                  </h3>
                  <p class="mt-auto pt-3 font-mono text-xs opacity-70">{cs.client}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="writing" class="pt-12 pb-6">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class={sectionHeading}>Latest writing</h2>
        <a href="/posts/" class={moreLink}>
          All posts <IconArrowRight class="inline-block size-4 rtl:-rotate-180" />
        </a>
      </div>
      <ul>
        {latestPosts.map(data => <Card variant="h3" {...data} />)}
      </ul>
    </section>

    <section id="contact" class="my-12 rounded-xl border border-border px-6 py-8 sm:px-10">
      <h2 class="text-2xl font-bold tracking-tight">Working on an AI initiative that needs to reach production?</h2>
      <p class="mt-2 max-w-[38rem] opacity-90">
        I'm happy to compare notes, whether you're scoping a first use case or trying to get a
        stalled pilot over the line.
      </p>
      <a href={CONTACT_HREF} class:list={[primaryButton, "mt-5"]}>Get in touch</a>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
